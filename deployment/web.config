<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security><requestFiltering><requestLimits maxAllowedContentLength="6291456" /></requestFiltering></security>
    <rewrite>
      <rules>
        <rule name="techMoral backend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
